// Build settings for the Glanslate app target.
//
// Signing: by default the app is signed to run locally. macOS remembers privacy
// permissions (Screen Recording, Accessibility) across rebuilds only when the
// app is signed consistently, so for day-to-day development copy
// Local.xcconfig.example to Local.xcconfig and set your team.

PRODUCT_NAME = Glanslate
PRODUCT_BUNDLE_IDENTIFIER = app.glanslate.Glanslate
MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 3

// The public GitHub repository (owner/name) whose latest release Glanslate offers
// as an update. Leave empty to build without update checks.
GLANSLATE_UPDATE_REPOSITORY = hkilimci/glanslate

MACOSX_DEPLOYMENT_TARGET = 26.0
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
SWIFT_VERSION = 6.0

INFOPLIST_FILE = Configs/Info.plist
GENERATE_INFOPLIST_FILE = NO
CODE_SIGN_ENTITLEMENTS = Configs/Glanslate.entitlements
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
COMBINE_HIDPI_IMAGES = YES
DEAD_CODE_STRIPPING = YES

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// Optional, untracked overrides such as DEVELOPMENT_TEAM and CODE_SIGN_IDENTITY.
#include? "Local.xcconfig"
